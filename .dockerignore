target/
.git/
.github/
.devcontainer/
release-assets/
release-binaries/
**/__pycache__/
*.md
!README.md

# Never send local environment files to the image builder.
**/.env
**/.env.*

# Local runtime configuration; preserve examples/ponydb.toml.
ponydb.toml
ponydb.*.toml

# Database exports, caches, and SQLite sidecar files.
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# Private keys and local credential stores.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/.ssh
**/.aws
**/.codex/auth.json
**/.claude/.credentials.json
**/.config/gh
**/.config/cursor
