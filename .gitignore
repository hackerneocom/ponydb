/target/
/release-assets/
/release-binaries/
__pycache__/

# Local environment files; keep credential-free templates available.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local runtime configuration; examples/ponydb.toml remains versioned.
/ponydb.toml
/ponydb.*.toml

# Database exports, caches, and SQLite sidecar files.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Private keys and local credential stores.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.ssh/
.aws/
**/.codex/auth.json
**/.claude/.credentials.json
**/.config/gh/
**/.config/cursor/
